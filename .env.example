# ---- HCM Lite environment ----
# Copy to .env for local runs. Never commit real secrets.

# Server port (next start)
PORT=3000

# JSON data file directory (starts empty; created on first setup)
# Defaults to ./data — survives restarts. On Vercel use /tmp for a demo instance.
DATA_DIR=./data

# Auth
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime is 8 hours.

# AI assistant (server-side only — the browser never calls the provider)
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Optional env bootstrap for first-run setup (POST /api/setup still required)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Timezone used for "the day" computations (default Asia/Karachi)
TZ_NAME=Asia/Karachi
